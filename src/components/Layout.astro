---
import "@/styles/globals.css";
import { siteLink, absUrl } from "@/lib/url";
import { sourceListText } from "@/lib/feed";

interface Props {
  title?: string;
  description?: string;
}

// ソース名は SOURCES（src/lib/feed.ts）から組み立てる＝ソースを増減しても文言が古びない。
const {
  title = "today.security — セキュリティ情報フィード",
  description = `${sourceListText()} からセキュリティ関連情報を集約する個人フィード。`,
} = Astro.props;

const ogImage = absUrl("/og-default.png");

// canonical / og:url。Astro.url.pathname は既に base（/todayai）込みなので absUrl() に
// 渡すと base が二重付与になる → Astro.site を基点に new URL で組む。
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Cloudflare Web Analytics — Cookie 不要のプライバシー配慮解析（バナー不要）。
// PUBLIC_CF_BEACON_TOKEN（.env / リポジトリ変数）が入っていればビーコンを出力し、
// 未設定なら何も出さない＝ビルドは壊れない（graceful）。トークンはページソースに出る
// 公開値なので secret ではなくリポジトリ「変数」で渡す。
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={siteLink("/favicon.svg")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="today.security"
      href={siteLink("/rss.xml")}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {
      cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }
  </head>
  <body>
    <!-- pb-6: ページ末尾の余白。以前は画面下端に固定表示していたサイト間ナビ（h-9）に
         フッターが隠れないための逃げが必要だったが、そのバーを削除したので通常の余白まで詰めた。 -->
    <div class="mx-auto flex min-h-screen max-w-[46rem] flex-col px-4 pb-6 sm:px-6 lg:max-w-[58rem]">
      <header
        id="app-header"
        class="sticky-surface sticky top-0 z-20 -mx-4 mb-2 border-b border-[var(--color-border)] px-4 py-3 sm:-mx-6 sm:px-6"
      >
        <div class="flex items-center justify-between gap-3">
          <a href={siteLink("/")} class="group flex items-center gap-2.5">
            <span
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--color-logo)] font-mono text-sm font-bold text-white shadow-[0_2px_10px_var(--color-logo-glow)]"
              >sec</span
            >
            <span class="font-display text-[16px] font-bold tracking-tight">
              today<span class="text-[var(--color-logo)]">.security</span>
            </span>
          </a>
          <nav class="flex items-center gap-1 font-mono text-[12px] text-[var(--color-text-muted)]">
            <a
              href={siteLink("/")}
              class="rounded-md px-2.5 py-1.5 transition-colors hover:bg-[var(--color-card-hover)] hover:text-[var(--color-text)]"
              >FEED</a
            >
            <a
              href={siteLink("/about")}
              class="rounded-md px-2.5 py-1.5 transition-colors hover:bg-[var(--color-card-hover)] hover:text-[var(--color-text)]"
              >ABOUT</a
            >
            <a
              href={siteLink("/rss.xml")}
              class="rounded-md px-2.5 py-1.5 transition-colors hover:bg-[var(--color-card-hover)] hover:text-[var(--color-text)]"
              aria-label="RSS"
              >RSS</a
            >
          </nav>
        </div>
      </header>

      <!-- pb-10: 本文とフッターの間隔。日付グループ間（space-y-8＝32px）より広く取り、
           フッターが「本文の続き」ではなく別の層に見えるようにしている。 -->
      <main class="flex-1 pb-10">
        <slot />
      </main>

      <footer
        class="border-t border-[var(--color-border)] py-6 text-center text-[12px] text-[var(--color-text-subtle)]"
      >
        <p>
          today.security — セキュリティ情報を1つのフィードに。{sourceListText(" / ")} から自動集約。
        </p>
      </footer>
    </div>
  </body>
</html>

---
import Layout from "@/components/Layout.astro";
import { SOURCES } from "@/lib/feed";

// 情報源カードは SOURCES（src/lib/feed.ts）から生成する。
// ソースを増やしたのにこのページだけ古いまま、という取りこぼしを防ぐため。
---

<Layout title="このサイトについて — today.security">
  <section class="prose-invert pt-6">
    <h1 class="text-[22px] font-bold tracking-tight">このサイトについて</h1>

    <p class="mt-4 text-[14px] leading-relaxed text-[var(--color-text-muted)]">
      <strong class="text-[var(--color-text)]">today.security</strong> は、セキュリティ関連の情報を1つのタイムラインにまとめて読むための個人用フィードです。
      以下の情報源を自動取得し、時系列で表示します。
    </p>

    <p class="mt-3 text-[14px] leading-relaxed text-[var(--color-text-muted)]">
      個人の学習を目的として運用しているサイトであり、特定の組織を代表するものではありません。
      掲載内容は各情報源の見出し・抜粋であり、正確性を保証するものではありません。
    </p>

    <div class="mt-6 space-y-3">
      {
        SOURCES.map((s) => (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-card)] p-4">
            <span
              class={`${s.badgeClass} inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold`}
            >
              {s.label}
            </span>
            <p class="mt-2 text-[13px] text-[var(--color-text-muted)]">{s.description}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-6 text-[12px] text-[var(--color-text-subtle)]">
      GitHub Actions でフィードを取得し、GitHub Pages に静的サイトとしてデプロイしています。
      各アイテムのリンク先は元の投稿・記事です。
    </p>
  </section>
</Layout>
